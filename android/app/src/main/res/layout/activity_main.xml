<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f2f5">

    <!-- Title bar (long press to change URL) -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1a1a2e"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="horizontal"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold to configure"
            android:textColor="#8892b0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Loading bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#e31837"
        android:visibility="gone"
        android:layout_below="@id/titleBar" />

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBar"
        android:layout_alignParentBottom="true" />

    <!-- Error / offline screen -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#f0f2f5"
        android:visibility="gone"
        android:layout_below="@id/progressBar"
        android:layout_alignParentBottom="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cannot connect to server"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1a1a2e"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvErrorUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Retry"
            android:backgroundTint="#e31837"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnChangeUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Change Server URL"
            android:backgroundTint="#1a1a2e"
            android:textColor="#ffffff" />

    </LinearLayout>

</RelativeLayout>
